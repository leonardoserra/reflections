<div class="form-card">
  <h1 class="section-title">New Journal</h1>

  <%= form_with model: @document do |form| %>
    <div class="field">
      <%= form.text_field :name, required: true, placeholder: "Name", autofocus: true, maxlength: 50 %>
    </div>

    <div class="form-actions">
      <%= form.submit class: "button primary" %>
      <%= link_to "Cancel", root_path, class: "button secondary" %>
    </div>
  <% end %>
</div>
