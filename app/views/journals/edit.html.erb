<div class="form-card">
  <h1 class="section-title">Edit Journal</h1>

  <%= form_with model: @document do |form| %>
    <div class="field">
      <%= form.text_field :name, placeholder: "Name", autofocus: true %>
    </div>

    <div class="form-actions">
      <%= form.submit "Update", class: "button primary" %>
      <%= link_to "Cancel", @document, class: "button secondary" %>
    </div>
  <% end %>
</div>
