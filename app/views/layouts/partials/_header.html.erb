<header>
  <nav>
    <div class="nav-left">
      <%= link_to "Home", root_path, class: "button primary sm" %>
      <% unless authenticated? %>
        <% if current_page?(new_registration_path) %>
          <%= link_to "Login", new_session_path, class: "button primary sm" %>
        <% else %>
          <%= link_to "Register", new_registration_path, class: "button primary sm" %>
        <% end %>
      <% end %>
      <%= button_to "Log out", session_path, method: :delete, class: "button secondary sm" if authenticated? %>
    </div>
    <div class="nav-center">
      <% if authenticated? %>
        Logged with: [<%= Current.user&.name %>]
      <% end %>
    </div>
    <div class="nav-right">
    </div>
  </nav>
</header>
