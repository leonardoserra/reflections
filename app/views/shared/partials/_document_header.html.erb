<h1><%= document.name %></h1>
<% if document.is_a?(Book) && document.author.present? %>
  <p class="author">by <%= document.author %></p>
<% end %>
<% if document.is_a?(Journal) && local_assigns[:current_page]&.created_at.present? %>
  <p class="author">Created <%= current_page.created_at.strftime("%B %d, %Y at %H:%M") %></p>
<% end %>
