<% if total_pages > 1 %>
  <nav class="pagination">
    <%= link_to "<<", polymorphic_path(document, page: 1), class: "page-link" %>
    <%= link_to "<", polymorphic_path(document, page: [current_page_num - 1, 1].max), class: "page-link" %>

    <% range_start = [current_page_num - 3, 1].max %>
    <% range_end = [current_page_num + 3, total_pages].min %>

    <% (range_start..range_end).each do |n| %>
      <%= link_to n, polymorphic_path(document, page: n), class: "page-link #{'active' if n == current_page_num}" %>
    <% end %>

    <%= link_to ">", polymorphic_path(document, page: [current_page_num + 1, total_pages].min), class: "page-link" %>
    <%= link_to ">>", polymorphic_path(document, page: total_pages), class: "page-link" %>
  </nav>
<% end %>
