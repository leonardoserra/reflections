<%= turbo_stream.replace dom_id(@page, :body) do %>
  <%= render "shared/partials/page_body", current_page: @page, form_visible: @page.errors.any? %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <% if @page.errors.any? %>
    <div class="flash alert" data-controller="flash"><%= @page.errors.full_messages.to_sentence %></div>
  <% else %>
    <div class="flash notice" data-controller="flash">Page updated.</div>
  <% end %>
<% end %>
