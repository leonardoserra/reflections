<% if @page.errors.any? %>
  <%= turbo_stream.replace dom_id(@page, :body) do %>
    <%= render "shared/partials/page_body", current_page: @page %>
  <% end %>
  <%= turbo_stream.update "flash" do %>
    <div class="flash alert"><%= @page.errors.full_messages.to_sentence %></div>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@page, :body) do %>
    <%= render "shared/partials/page_body", current_page: @page %>
  <% end %>
  <%= turbo_stream.update "flash" do %>
    <div class="flash notice">Page updated.</div>
  <% end %>
<% end %>
