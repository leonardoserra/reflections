<h1>Edit book</h1>

<%= form_with model: @document do |form| %>
  <div>
    <%= form.text_field :name, required: true, placeholder: "Title", autofocus: true %>
  </div>

  <div>
    <%= form.text_field :author, placeholder: "Author" %>
  </div>

  <div>
    <%= form.submit "Update" %>
  </div>
<% end %>

<%= link_to "Cancel", @document %>
